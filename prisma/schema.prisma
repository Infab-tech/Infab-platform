generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. INQUIRIES
model Inquiry {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  organization String?
  interest     String
  message      String   @db.Text
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@index([status])
}

// 2. PRODUCTS
model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  category     String
  description  String   @db.Text
  specs        Json?
  imageUrl     String?
  imageUrls    String[]
  datasheetUrl String?
  drawingUrl   String?
  cadFileUrls  String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  quoteItems   QuoteItem[]

  @@index([isActive, category])
}

// 3. QUOTE REQUESTS (The "Cart/Order")
model QuoteRequest {
  id             String      @id @default(cuid())
  userId         String      // Links to the Supabase Auth User ID
  userEmail      String      // Stored for easy reference
  status         String      @default("PENDING") // PENDING, REVIEWING, QUOTED, ACCEPTED
  notes          String?     @db.Text
  deletedByAdmin Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  
  items          QuoteItem[]
  messages       QuoteMessage[]

  @@index([userId])
  @@index([status])
}

// 4. QUOTE ITEMS (The individual products inside the request)
model QuoteItem {
  id             String   @id @default(cuid())
  quoteRequestId String
  productId      String
  quantity       Int      @default(1)
  
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])

  @@index([quoteRequestId])
}

// 5. QUOTE MESSAGES (Two-way chat system)
model QuoteMessage {
  id             String       @id @default(cuid())
  quoteRequestId String
  senderRole     String       // "ADMIN" or "CUSTOMER"
  senderEmail    String       // Email of who sent it
  text           String       @db.Text
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@index([quoteRequestId, senderRole, isRead])
}

// 6. NEWS ARTICLES
model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  category    String   @default("General")
  link        String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([publishedAt])
}

// 7. TEAM MEMBERS
model TeamMember {
  id       String   @id @default(cuid())
  name     String
  title    String
  bio      String?  @db.Text
  section  String   // FOUNDER | RESEARCH | ENGINEERING | CONSULTANTS | BUSINESS
  photoUrl    String?
  linkedinUrl String?
  order    Int      @default(0)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// 8. RECOGNITIONS
model Recognition {
  id          String   @id @default(cuid())
  title       String   // e.g. "ISO 9001:2015"
  body        String   // short description
  certNumber  String?  // optional cert number
  issuer      String?  // e.g. "Bureau Veritas"
  logoUrl     String?  // Supabase Storage
  order       Int      @default(0)
  isActive    Boolean  @default(true)
}

// 9. USER ROLES (RBAC)
model userRole {
  email     String   @id
  role      String   @default("CUSTOMER") // CUSTOMER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("UserRole")
}

// 10. PARTNERS (Clients, collaborators, etc.)
model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// 11. CART DRAFT (Server-side persistence for user's quote cart)
model CartDraft {
  userId    String   @id
  items     Json     // Stores the cart items array
  updatedAt DateTime @default(now()) @updatedAt
}

// 12. CAREERS
model JobOpening {
  id           String           @id @default(cuid())
  title        String
  department   String
  type         JobType
  location     String           @default("Bangalore, India")
  description  String
  requirements String[]
  deadline     DateTime?
  applyLink    String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())

  applications JobApplication[]
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

// 13. JOB APPLICATIONS
model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  job         JobOpening        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  coverLetter String?           @db.Text
  resumeUrl   String
  status      ApplicationStatus @default(NEW)
  createdAt   DateTime          @default(now())

  @@index([jobId])
  @@index([status])
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

// 14. FACILITY ITEMS (admin-editable facilities list)
model FacilityItem {
  id          String   @id @default(cuid())
  icon        String   @default("ph-wrench")
  title       String
  description String   @db.Text
  photoUrl    String?
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([isActive, order])
}

// 15. SERVICE ITEMS (admin-editable services list)
model ServiceItem {
  id          String   @id @default(cuid())
  category    String   // "mems-capability" | "mems-process" | "micro-design" | "micro-fab" | "micro-device"
  icon        String   @default("ph-gear")
  title       String
  description String   @db.Text
  detail      String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([isActive, category, order])
}