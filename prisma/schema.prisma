generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. INQUIRIES
model Inquiry {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  organization String?
  interest     String
  message      String   @db.Text
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

// 2. PRODUCTS
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  description String   @db.Text
  specs       Json?
  imageUrl    String?
  imageUrls   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  quoteItems  QuoteItem[]
}

// 3. QUOTE REQUESTS (The "Cart/Order")
model QuoteRequest {
  id             String      @id @default(cuid())
  userId         String      // Links to the Supabase Auth User ID
  userEmail      String      // Stored for easy reference
  status         String      @default("PENDING") // PENDING, REVIEWING, QUOTED, ACCEPTED
  notes          String?     @db.Text
  deletedByAdmin Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  
  items          QuoteItem[]
  messages       QuoteMessage[]

  @@index([userId])
}

// 4. QUOTE ITEMS (The individual products inside the request)
model QuoteItem {
  id             String   @id @default(cuid())
  quoteRequestId String
  productId      String
  quantity       Int      @default(1)
  
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])

  @@index([quoteRequestId])
}

// 5. QUOTE MESSAGES (Two-way chat system)
model QuoteMessage {
  id             String       @id @default(cuid())
  quoteRequestId String
  senderRole     String       // "ADMIN" or "CUSTOMER"
  senderEmail    String       // Email of who sent it
  text           String       @db.Text
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

// 6. NEWS ARTICLES
model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  category    String   @default("General")
  link        String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([publishedAt])
}

// 7. TEAM MEMBERS
model TeamMember {
  id       String   @id @default(cuid())
  name     String
  title    String
  bio      String?  @db.Text
  section  String   // FOUNDER | RESEARCH | ENGINEERING | CONSULTANTS | BUSINESS
  photoUrl    String?
  linkedinUrl String?
  order    Int      @default(0)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// 8. PUBLICATIONS
model Publication {
  id          String   @id @default(cuid())
  title       String
  authors     String
  journal     String?
  year        Int
  abstract    String?  @db.Text
  link        String?
  imageUrl    String?
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// 9. USER ROLES (RBAC)
model userRole {
  email     String   @id
  role      String   @default("CUSTOMER") // CUSTOMER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("UserRole")
}

// 10. PARTNERS (Clients, collaborators, etc.)
model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// 11. CART DRAFT (Server-side persistence for user's quote cart)
model CartDraft {
  userId    String   @id
  items     Json     // Stores the cart items array
  updatedAt DateTime @default(now()) @updatedAt
}